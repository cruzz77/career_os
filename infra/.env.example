# Copy to infra/.env (chmod 600, never committed). Compose reads it for variable substitution
# and passes it to the api and migrate containers.
POSTGRES_USER=careeros
POSTGRES_PASSWORD=__DB_PASSWORD__
POSTGRES_DB=careeros
# Inside the stack, Postgres is reached by its service name on the internal network.
DATABASE_URL=postgresql+psycopg://careeros:__DB_PASSWORD__@db:5432/careeros
ENVIRONMENT=production
FRONTEND_ORIGIN=https://careeros.example.com
PROXY_SECRET=__PROXY_SECRET__
# Set by the deploy workflow to the GHCR image tagged with the git SHA.
API_IMAGE=careeros-api:local
# Local dev only (docker-compose.dev.yml): host port for Postgres, loopback-bound.
# POSTGRES_HOST_PORT=5433
