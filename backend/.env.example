# Host development: copy to backend/.env (chmod 600, never committed), then run
#   uv run --env-file .env uvicorn app.main:create_app --factory --reload
# Postgres comes from: docker compose -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up -d db
ENVIRONMENT=local
LOG_JSON=false
DATABASE_URL=postgresql+psycopg://careeros:__DB_PASSWORD__@127.0.0.1:__DB_PORT__/careeros
FRONTEND_ORIGIN=http://localhost:3000
PROXY_SECRET=__PROXY_SECRET__
SESSION_COOKIE_SECURE=false
